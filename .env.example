# Export these variables in your shell. This file is documentation, not auto-loaded.
# Default: extractive answers, no external API calls.
GENERATION_BACKEND=extractive
# Set GENERATION_BACKEND=llm to enable an OpenAI-compatible chat endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Optional multilingual neural retrieval. Install: uv sync --extra semantic
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# Optional local Ollama (no external requests or paid API):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_ALLOW_LOCAL_HTTP=1
# LLM_MODEL=qwen3.5:2b
# LLM_API_KEY=ollama
# LLM_REASONING_EFFORT=none
